{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POORCRAFT original runtime asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinate_system", "assets"],
  "properties": {
    "schema_version": {"const": 2},
    "coordinate_system": {"const": "meters,+Y-up,-Z-forward"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "provenance", "source", "compiled", "materials", "lods", "collision", "runtime_consumer", "proof_scene"],
        "properties": {
          "id": {"type": "string", "pattern": "^(prop|module|character|material|effect)\\.[a-z0-9_]+$"},
          "category": {"enum": ["prop", "module", "character", "material", "effect"]},
          "status": {"enum": ["planned", "source_ready", "compiled", "integrated", "proven"]},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "license_or_originality", "reviewed"],
            "properties": {
              "kind": {"enum": ["original_manual", "original_procedural", "compatible_license"]},
              "license_or_originality": {"type": "string", "minLength": 12},
              "reviewed": {"type": "boolean"}
            }
          },
          "source": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(assets-src|tools)/"}},
          "compiled": {"type": "string", "pattern": "^assets/compiled/.+\\.glb$"},
          "materials": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^mat\\."}},
          "lods": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "max_triangles"], "properties": {"name": {"enum": ["lod0", "lod1", "lod2", "impostor"]}, "max_triangles": {"type": "integer", "minimum": 1}}}},
          "collision": {"type": "object", "additionalProperties": false, "required": ["kind", "blocks_navigation"], "properties": {"kind": {"enum": ["none", "box", "capsule", "convex", "mesh"]}, "blocks_navigation": {"type": "boolean"}}},
          "sockets": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "runtime_consumer": {"type": "string", "minLength": 4},
          "proof_scene": {"type": "string", "minLength": 4}
        }
      }
    }
  }
}

